# Bible API — Railway STAGING — Native authentication (NOT for production yet)
# Paste in bible-api > Variables > RAW Editor. Replace every SUBSTITUIR.
# Railway injects PORT; do not manually expose database/admin secrets.
BIBLE_ENVIRONMENT=staging
BIBLE_AUTH_MODE=native_session
BIBLE_RELEASE_SHA=SUBSTITUIR_COMMIT_SHA_REAL_DA_API
DATABASE_URL=SUBSTITUIR_URL_PRIVADA_POSTGRES_DA_ROLE_BIBLE_APP
BIBLE_DATABASE_REQUIRED=true
BIBLE_AUTO_CREATE_SCHEMA=false

# Exact public FRONTEND HTTPS origin, no path/trailing slash
BIBLE_NATIVE_PUBLIC_ORIGIN=https://SUBSTITUIR_FRONTEND.up.railway.app
BIBLE_ALLOWED_ORIGINS=https://SUBSTITUIR_FRONTEND.up.railway.app
BIBLE_NATIVE_SESSION_COOKIE_NAME=__Host-bible_session
BIBLE_NATIVE_SESSION_TTL_HOURS=12
BIBLE_NATIVE_SESSION_SECRET=SUBSTITUIR_SEGREDO_EXCLUSIVO_64_HEX_OU_MAIS

# Do not enable open registration before AO-01 validates PostgreSQL, abuse and email.
BIBLE_NATIVE_REGISTRATION_ENABLED=false
BIBLE_NATIVE_LOGIN_MAX_ATTEMPTS=8
BIBLE_NATIVE_LOGIN_WINDOW_MINUTES=15

# Do not enable reset before email delivery/replay/abuse gate.
BIBLE_NATIVE_PASSWORD_RESET_ENABLED=false
BIBLE_NATIVE_RESET_TTL_MINUTES=20
# BIBLE_NATIVE_SMTP_HOST=SUBSTITUIR_HOST_SMTP
# BIBLE_NATIVE_SMTP_PORT=587
# BIBLE_NATIVE_SMTP_USER=SUBSTITUIR_USUARIO_SMTP
# BIBLE_NATIVE_SMTP_PASSWORD=SUBSTITUIR_SENHA_SMTP
# BIBLE_NATIVE_SMTP_FROM=no-reply@SUBSTITUIR_DOMINIO

BIBLE_RESTRICTED_DATA_KEY=SUBSTITUIR_SEGREDO_RESTRITO_EXCLUSIVO_64_HEX_OU_MAIS
BIBLE_CONTENT_SOURCE_ID=bible-livre
BIBLE_CONTENT_SOURCE_VERSION=2025.1.0
BIBLE_RATE_LIMIT_PER_MINUTE=60
BIBLE_DOCS_ENABLED=false
BIBLE_LOG_RESTRICTED_CONTENT=false

# Commercial billing explicitly OFF
BIBLE_BILLING_PLANS_JSON={}
BIBLE_BILLING_SANDBOX_CHECKOUT_ENABLED=false
BIBLE_BILLING_WEBHOOK_SANDBOX_ENABLED=false
# BIBLE_BILLING_WEBHOOK_TOKEN=UNSET
# BIBLE_BILLING_ASAAS_SANDBOX_KEY=UNSET
# BIBLE_BILLING_SANDBOX_SUCCESS_URL=UNSET
# UNSET entirely: BIBLE_OIDC_*, BIBLE_DEMO_*, PLATFORM_*, BIBLE_DEV_EPHEMERAL_KEY
